  - m_Id: 24781258357747712
    m_Localized: RPS
    m_Metadata:
      m_Items: []
  - m_Id: 24781258743623680
    m_Localized: Guerrero, Maga y Asesino
    m_Metadata:
      m_Items: []
  - m_Id: 24781258743623681
    m_Localized: "Ta\u015F, k\xE2\u011F\u0131t, makas"
