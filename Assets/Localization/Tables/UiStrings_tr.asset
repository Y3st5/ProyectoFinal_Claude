    m_Metadata:
      m_Items: []
  - m_Id: 24781258752012289
    m_Localized: "UGS \xFCzerinden bir rakibe kar\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206592
    m_Localized: "\xC7evrimi\xE7i RPS yak\u0131nda geliyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206593
    m_Localized: "Ta\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206594
    m_Localized: "K\xE2\u011F\u0131t"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206595
    m_Localized: Makas
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206596
    m_Localized: "Tur {0} - s\u0131ra sende"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206597
    m_Localized: Tur {0} - {1} bekleniyor
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206598
    m_Localized: "YZ d\xFC\u015F\xFCn\xFCyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206599
    m_Localized: Sen
    m_Metadata:
      m_Items: []
  - m_Id: 24781258756206600
