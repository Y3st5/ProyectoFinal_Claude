    m_Metadata:
      m_Items: []
  - m_Id: 1795178498
    m_Localized: "Vazge\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1795178499
    m_Localized: Oyuncu
    m_Metadata:
      m_Items: []
  - m_Id: 1795178500
    m_Localized: "Yak\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 1795178501
    m_Localized: TIC TAC XO
    m_Metadata:
      m_Items: []
  - m_Id: 1795178502
    m_Localized: "Y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 1795178503
    m_Localized: "Bir \u015Feyler ters gitti. Ba\u011Flant\u0131n\u0131 kontrol edip
      tekrar dene."
    m_Metadata:
      m_Items: []
  - m_Id: 1795178504
    m_Localized: Tekrar dene
    m_Metadata:
      m_Items: []
  - m_Id: 1795178505
    m_Localized: TIC TAC XO
    m_Metadata:
      m_Items: []
  - m_Id: 1795178506
    m_Localized: Oyna
    m_Metadata:
      m_Items: []
  - m_Id: 1795178507
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 1795178508
    m_Localized: "Ma\u011Faza"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372800
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1799372801
    m_Localized: "Bir mod se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372802
    m_Localized: Tek oyunculu
    m_Metadata:
      m_Items: []
  - m_Id: 1799372803
    m_Localized: "Yapay zekaya kar\u015F\u0131 oyna \xB7 zorluk se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372804
    m_Localized: "Yerel 2 ki\u015Filik"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372805
    m_Localized: "Ayn\u0131 cihaz"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372806
    m_Localized: "\xC7evrimi\xE7i"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372807
    m_Localized: "H\u0131zl\u0131 E\u015Fle\u015Fme veya Ranked"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372808
    m_Localized: "Yak\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372809
    m_Localized: "\xC7evrimi\xE7i mod yak\u0131nda geliyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372810
    m_Localized: Tahta boyutu
    m_Metadata:
      m_Items: []
  - m_Id: 1799372811
    m_Localized: '{0} hizala'
    m_Metadata:
      m_Items: []
  - m_Id: 1799372812
    m_Localized: Zorluk
    m_Metadata:
      m_Items: []
  - m_Id: 1799372813
    m_Localized: Kolay
    m_Metadata:
      m_Items: []
  - m_Id: 1799372814
    m_Localized: Orta
    m_Metadata:
      m_Items: []
  - m_Id: 1799372815
    m_Localized: Zor
    m_Metadata:
      m_Items: []
  - m_Id: 1799372816
    m_Localized: "Uyarlamal\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372817
    m_Localized: "Oyunu ba\u015Flat"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372818
    m_Localized: Sen
    m_Metadata:
      m_Items: []
  - m_Id: 1799372819
    m_Localized: Rakip
    m_Metadata:
      m_Items: []
  - m_Id: 1799372820
    m_Localized: "YZ d\xFC\u015F\xFCn\xFCyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 1799372821
    m_Localized: Oyuncu 1
    m_Metadata:
      m_Items: []
  - m_Id: 1799372822
    m_Localized: Oyuncu 2
    m_Metadata:
      m_Items: []
  - m_Id: 1799372823
    m_Localized: "Duraklat\u0131ld\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372824
    m_Localized: "Kazand\u0131n! \U0001F389"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372825
    m_Localized: Kaybettin
    m_Metadata:
      m_Items: []
  - m_Id: 1799372826
    m_Localized: Berabere
    m_Metadata:
      m_Items: []
  - m_Id: 1799372827
    m_Localized: "Oyuncu 1 kazand\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372828
    m_Localized: "Oyuncu 2 kazand\u0131!"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372829
    m_Localized: "\xD6d\xFCl"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372830
    m_Localized: "R\xF6van\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372831
    m_Localized: Ana sayfa
    m_Metadata:
      m_Items: []
  - m_Id: 1799372832
    m_Localized: Profil
    m_Metadata:
      m_Items: []
  - m_Id: 1799372833
    m_Localized: "{0} G\xF6r\xFCn\xFCm\xFC d\xFCzenle {1}"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372834
    m_Localized: "Kazanma oran\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372835
    m_Localized: Seri
    m_Metadata:
      m_Items: []
  - m_Id: 1799372836
    m_Localized: "Ma\xE7 ge\xE7mi\u015Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372837
    m_Localized: Verilerimi sil
    m_Metadata:
      m_Items: []
  - m_Id: 1799372838
    m_Localized: Verilerim silinsin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 1799372839
    m_Localized: "Bu i\u015Flem bu cihazdaki yerel ilerlemeni, paran\u0131 ve ma\xE7
      ge\xE7mi\u015Fini kal\u0131c\u0131 olarak siler. Bu i\u015Flem geri al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 1799372840
    m_Localized: Sil
    m_Metadata:
      m_Items: []
  - m_Id: 1799372841
    m_Localized: "Ma\xE7 Ge\xE7mi\u015Fi"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372842
    m_Localized: "T\xFCm\xFC"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372843
    m_Localized: Tekli
    m_Metadata:
      m_Items: []
  - m_Id: 1799372844
    m_Localized: Yerel
    m_Metadata:
      m_Items: []
  - m_Id: 1799372845
    m_Localized: "Hen\xFCz ma\xE7 yok. Burada g\xF6rmek i\xE7in bir oyun oyna!"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372846
    m_Localized: Galibiyet
    m_Metadata:
      m_Items: []
  - m_Id: 1799372847
    m_Localized: "Kay\u0131p"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372848
    m_Localized: Berabere
    m_Metadata:
      m_Items: []
  - m_Id: 1799372849
    m_Localized: "Oyuncu 1 kazand\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372850
    m_Localized: "Oyuncu 2 kazand\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372851
    m_Localized: '{0}m {1}s'
    m_Metadata:
      m_Items: []
  - m_Id: 1799372852
    m_Localized: '{0}s'
    m_Metadata:
      m_Items: []
  - m_Id: 1799372853
    m_Localized: "Az \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372854
    m_Localized: "{0}m \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372855
    m_Localized: "{0} sa \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372856
    m_Localized: "{0}g \xF6nce"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372857
    m_Localized: "Ma\u011Faza"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372858
    m_Localized: "Ta\u015Flar"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372859
    m_Localized: Tahtalar
    m_Metadata:
      m_Items: []
  - m_Id: 1799372860
    m_Localized: FX
    m_Metadata:
      m_Items: []
  - m_Id: 1799372861
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 1799372862
    m_Localized: "Yak\u0131nda"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372863
    m_Localized: Yeni kozmetikler yolda.
    m_Metadata:
      m_Items: []
  - m_Id: 1799372864
    m_Localized: "Para birimi sat\u0131n alma yak\u0131nda geliyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372865
    m_Localized: Ayarlar
    m_Metadata:
      m_Items: []
  - m_Id: 1799372866
    m_Localized: Dil
    m_Metadata:
      m_Items: []
  - m_Id: 1799372867
    m_Localized: Ses
    m_Metadata:
      m_Items: []
  - m_Id: 1799372868
    m_Localized: "M\xFCzik"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372869
    m_Localized: "Hesab\u0131 ve verileri sil"
    m_Metadata:
      m_Items: []
  - m_Id: 1799372870
    m_Localized: Hesap ve veriler silinsin mi?
    m_Metadata:
      m_Items: []
  - m_Id: 33208380964864
    m_Localized: "H\u0131zl\u0131 E\u015Fle\u015Fme"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742080
    m_Localized: "\u015Eimdi \xE7evrimi\xE7i bir rakiple oyna"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742081
    m_Localized: Ranked
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742082
    m_Localized: "Rekabet\xE7i s\u0131ralama"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742083
    m_Localized: "Ranked yak\u0131nda geliyor!"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742084
    m_Localized: "Rakip aran\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742085
    m_Localized: "Ma\xE7a ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742086
    m_Localized: "\xC7ok mu uzun s\xFCr\xFCyor?"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742087
    m_Localized: "Yapay zekaya kar\u015F\u0131 oyna"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742088
    m_Localized: "\u25C9 Ba\u011Fland\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742089
    m_Localized: "\u25CC Ba\u011Flan\u0131l\u0131yor..."
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742090
    m_Localized: "\u25CC \xC7evrimd\u0131\u015F\u0131"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742091
    m_Localized: "Ma\xE7tan vazge\xE7ilsin mi?"
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742092
    m_Localized: "\u015Eimdi ayr\u0131l\u0131rsan rakibin kazan\u0131r. Bu i\u015Flem
      geri al\u0131namaz."
    m_Metadata:
      m_Items: []
  - m_Id: 33208397742093
    m_Localized: "Rakibin ma\xE7\u0131 terk etti."
    m_Metadata:
      m_Items: []
  - m_Id: 5869955727769600
    m_Localized: Ranked
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546816
    m_Localized: "S\u0131ralama (Ranked)"
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546817
    m_Localized: Ranked
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546818
    m_Localized: "Yerle\u015Ftirme {0}/{1}"
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546819
    m_Localized: Bronz
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546820
    m_Localized: "G\xFCm\xFC\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546821
    m_Localized: "Alt\u0131n"
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546822
    m_Localized: Platin
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546823
    m_Localized: Elmas
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546824
    m_Localized: "S\u0131ralama"
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546825
    m_Localized: "S\u0131ralama y\xFCkleniyor..."
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546826
    m_Localized: "Ranked s\u0131ralamas\u0131 burada hen\xFCz kullan\u0131lam\u0131yor.
      Yak\u0131nda tekrar kontrol et."
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546827
    m_Localized: "Bu tahtada hen\xFCz s\u0131ral\u0131 oyuncu yok."
    m_Metadata:
      m_Items: []
  - m_Id: 5869955744546828
    m_Localized: "S\u0131ralamaya kat\u0131lmak i\xE7in yerle\u015Ftirme ma\xE7lar\u0131n\u0131
      tamamla."
    m_Metadata:
      m_Items: []
  - m_Id: 5898106386268160
    m_Localized: Avatar
    m_Metadata:
      m_Items: []
  - m_Id: 5898106403045376
    m_Localized: "\xC7er\xE7eve"
    m_Metadata:
      m_Items: []
  - m_Id: 5898106403045377
    m_Localized: "Afi\u015F"
    m_Metadata:
      m_Items: []
  - m_Id: 5898106403045378
    m_Localized: "Ta\u015Flar"
    m_Metadata:
      m_Items: []
