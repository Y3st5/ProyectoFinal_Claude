    m_Metadata:
      m_Items: []
  - m_Id: 24781258747817985
    m_Localized: "Bir mod se\xE7"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258747817986
    m_Localized: Tek oyunculu
    m_Metadata:
      m_Items: []
  - m_Id: 24781258747817987
    m_Localized: "Be\u015Fte \xFC\xE7e kar\u015F\u0131 yapay zeka"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258747817988
    m_Localized: "Yerel 2 ki\u015Filik"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258747817989
    m_Localized: "Cihaz\u0131 tur tur devret"
    m_Metadata:
      m_Items: []
  - m_Id: 24781258752012288
