<?xml version="1.0" encoding="utf-8"?>
<!--
  Folder publish profile required by Cloud Code module deployment: the Deployment window /
  UGS CLI identify the solution's "main project" by this profile and use it to compile the
  module before zipping ("Could not find a Publish Profile" is raised without it).
  https://docs.unity.com/en-us/cloud-code/modules/how-to-guides/automate-local-deployment
-->
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <DeleteExistingFiles>false</DeleteExistingFiles>
    <ExcludeApp_Data>false</ExcludeApp_Data>
    <LaunchSiteAfterPublish>true</LaunchSiteAfterPublish>
    <LastUsedBuildConfiguration>Release</LastUsedBuildConfiguration>
    <LastUsedPlatform>Any CPU</LastUsedPlatform>
    <PublishProvider>FileSystem</PublishProvider>
    <PublishUrl>bin\Release\publish\</PublishUrl>
    <WebPublishMethod>FileSystem</WebPublishMethod>
    <_TargetId>Folder</_TargetId>
  </PropertyGroup>
</Project>
